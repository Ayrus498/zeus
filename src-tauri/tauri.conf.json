{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zeus",
  "version": "0.1.0",
  "identifier": "ai.zeus.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZEUS",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI coding agent powered by Ollama",
    "longDescription": "ZEUS is a desktop coding agent. Pick a project folder, choose a local Ollama model and let the agent read, edit and run code in your project, with every file change and command gated by a permission engine you control.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/app": "backend/app",
      "../backend/requirements.txt": "backend/requirements.txt",
      "../packaging/wheelhouse": "wheelhouse"
    },
    "linux": {
      "deb": {
        "depends": [
          "python3 (>= 3.10)",
          "python3-venv",
          "zenity",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "recommends": [
          "git",
          "ollama"
        ],
        "section": "devel",
        "files": {
          "/usr/bin/zeus-code": "../packaging/zeus-code"
        },
        "postInstallScript": "../packaging/debian/postinst",
        "preRemoveScript": "../packaging/debian/prerm"
      }
    }
  }
}
